{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tudu-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "SPACES", "class_name": "SyncSpace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncSpace"] }]
}
